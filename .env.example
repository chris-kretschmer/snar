# Copy to ".env" and fill in real values – ".env" itself is in .gitignore
# and never ends up in the repo. compose.yaml reads these variables via
# ${VAR} substitution (see there).

# Only used on the very first start: creates the first admin account.
# Afterwards, user management runs entirely inside the app and these
# values are ignored.
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-ein-sicheres-passwort-eintragen

# Only used on the very first start: initial short-domain – ends up in the
# QR codes! Manageable afterwards under /app/domains.
BASE_URL=https://example.com

# Optional: SSO login via OIDC (e.g. Authentik), see README.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
