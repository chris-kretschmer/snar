# Copy to ".env" and fill in real values – ".env" itself is in .gitignore
# and never ends up in the repo. compose.yaml reads these variables via
# ${VAR} substitution (see there).

# Only used on the very first start: creates the first admin account.
# Afterwards, user management runs entirely inside the app and these
# values are ignored.
ADMIN_USER=admin
# Needed until the first admin exists; snar refuses to start without it then.
# Remove it from this file afterwards.
ADMIN_PASSWORD=

# Only used on the very first start: initial short-domain – ends up in the
# QR codes! Manageable afterwards under /app/domains.
BASE_URL=https://example.com

# Optional: "0.0.0.0" publishes the port on all interfaces (default: 127.0.0.1, only this machine).
# Use it for a test in your LAN; in production put a reverse proxy with HTTPS in front.
# BIND_ADDRESS=127.0.0.1

# Optional: delete clicks older than this many days (daily). 0 keeps everything.
# CLICK_RETENTION_DAYS=0

# Optional: at least 32 random characters. Keeps the session secret out of the database and its backups.
# SESSION_SECRET=

# Optional: "off" disables the update hint for admins (sidebar), which asks
# the GitHub Releases API every few hours whether a newer version exists.
# UPDATE_CHECK=off

# Optional: SSO login via OIDC (e.g. Authentik), see README.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_GROUPS=
# OIDC_ALLOWED_EMAIL_DOMAINS=
